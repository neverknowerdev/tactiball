# OnchainKit Configuration
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_api_key_here
NEXT_PUBLIC_ONCHAINKIT_PROJECT_NAME=your_project_name_here
NEXT_PUBLIC_ICON_URL=your_icon_url_here
NEXT_PUBLIC_URL=your_app_url_here

# Database Configuration
# Falls back to postgres://postgres:postgres@localhost:5432/postgres when unset
DB_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/postgres

# Ably Configuration
NEXT_PUBLIC_ABLY_API_KEY=your_ably_api_key_here

# Coinbase Paymaster Configuration (Required - for gas sponsorship)
# Only the RPC URL is required - no API key needed
COINBASE_PAYMASTER_RPC_URL=https://api.developer.coinbase.com/rpc/v1/base-mainnet/

# Zealy Integration Configuration
ZEALY_COMMUNITY_SECRET=your_zealy_community_secret_here
