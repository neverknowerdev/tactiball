{
  "name": "tactiball-v2-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "engine": "../scripts/build-engine-wasm.sh",
    "bindings": "icp-bindgen --did-file ../crates/backend/backend.did --out-dir lib/bindings --force",
    "prepare-build": "npm run engine && npm run bindings",
    "dev": "npm run prepare-build && next dev -p 3001",
    "build": "npm run prepare-build && next build",
    "typecheck": "npm run prepare-build && tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@coinbase/onchainkit": "0.38.19",
    "@icp-sdk/core": "^6.1.0",
    "@tanstack/react-query": "^5",
    "next": "^15.3.3",
    "react": "^18",
    "react-dom": "^18",
    "react-toastify": "^11.0.5",
    "viem": "^2.27.2",
    "wagmi": "^2.16.0"
  },
  "devDependencies": {
    "@icp-sdk/bindgen": "^0.4.1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.3.3",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
