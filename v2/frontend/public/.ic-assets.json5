// Asset canister rules. `.well-known` is a dot-folder, so it must be
// un-ignored for custom domains (/.well-known/ic-domains) to be served.
[
  {
    "match": ".well-known",
    "ignore": false
  },
  {
    "match": "**/*",
    "headers": {
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "same-origin"
    }
  }
]
