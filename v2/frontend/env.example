# Only needed for `npm run dev` (next dev). When the app is served by the
# asset canister, it reads the backend id and root key from the `ic_env`
# cookie and needs no configuration.

# Backend canister id: icp canister status backend -e local --id-only
NEXT_PUBLIC_BACKEND_CANISTER_ID=
# Local network gateway (icp network start) or https://icp-api.io for mainnet
NEXT_PUBLIC_IC_HOST=http://localhost:8000

# Optional
# NEXT_PUBLIC_CDP_CLIENT_API_KEY=        # OnchainKit (Basenames, wallet UI)
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=         # used when a wallet adds Robinhood Chain
# NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
